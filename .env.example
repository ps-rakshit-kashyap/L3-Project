# ==========================================
# TalentForge Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development

# Database Connection (PostgreSQL with psycopg driver for SQLAlchemy 2.x)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talentforge

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future Phase Integration Placeholders
LLM_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
